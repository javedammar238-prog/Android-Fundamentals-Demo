<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="MainActivity (Lifecycle &amp; Intents)"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnAnonymousClick"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="1. Anonymous OnClickListener"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnInterfaceClick"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="2. Interface OnClickListener"
        android:layout_marginBottom="8dp" />

    <Button
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="3. XML android:onClick"
        android:onClick="onXmlButtonClick"
        android:layout_marginBottom="24dp" />

    <EditText
        android:id="@+id/etInputData"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Data to send FORWARD"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnSendForward"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Send Forward &amp; Open Second Activity"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tvResultBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Data received BACKWARD will appear here"
        android:textSize="14sp"
        android:textColor="@android:color/holo_blue_dark" />

</LinearLayout>
